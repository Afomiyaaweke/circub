// circub — Prisma schema for PostgreSQL (production target).
// Used when DATABASE_URL starts with postgresql://
// To use: DATABASE_URL=postgresql://... npx prisma db push --schema prisma/schema.postgres.prisma
//
// Differences from schema.prisma (SQLite):
// - provider = "postgresql" (enables native Postgres features + connection pooling)
// - Same models + indexes — only the datasource changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String?
  avatarColor    String   @default("teal")
  bio            String?
  headline       String?
  location       String?
  postsCount     Int      @default(0)
  followersCount Int      @default(0)
  likesCount     Int      @default(0)
  connectionsCount Int    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accountType    String   @default("PERSONAL")
  isLocal        Boolean  @default(false)
  verifiedLocal  Boolean  @default(false)

  companyName    String?
  companyWebsite String?
  companyLogo    String?
  companySize    String?
  companyIndustry String?

  rating         Float    @default(0)
  expertiseTags  String?
  helpfulVotes   Int      @default(0)
  localPostCount Int      @default(0)

  isGuide        Boolean  @default(false)
  guideLicense   String?
  guideLanguages String?
  guideSpecialties String?
  guideHourlyRate Float?
  guideCurrency  String?
  guideBio       String?
  guideAvailable Boolean  @default(true)
  profilePicture String?

  products       Product[]
  posts          Post[]
  postLikes      PostLike[]
  comments       Comment[]
  productLikes   Like[]
  localPricePosts LocalPricePost[]
  localPriceVotes LocalPriceVote[]
  localPriceReports LocalPriceReport[]
  guideRatingsReceived GuideRating[] @relation("GuideRatingReceiver")
  guideRatingsGiven GuideRating[] @relation("GuideRatingRater")

  connRequested  Connection[] @relation("ConnRequester")
  connReceived  Connection[] @relation("ConnReceiver")

  msgsSent       Message[]    @relation("MsgSender")
  msgsReceived   Message[]    @relation("MsgReceiver")

  @@index([accountType])
  @@index([isLocal, verifiedLocal])
  @@index([isGuide, guideAvailable])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  quantity    String
  country     String
  currency    String
  price       Float
  unit        String?
  gender      String?
  description String?
  imageUrl    String?
  category    String   @default("Other")
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       Like[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([category])
  @@index([country])
}

model Like {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

model Connection {
  id           String   @id @default(cuid())
  requesterId  String
  receiverId   String
  status       String   @default("PENDING")
  note         String?
  requester    User     @relation("ConnRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver     User     @relation("ConnReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

model Post {
  id          String     @id @default(cuid())
  content     String
  imageUrl    String?
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       PostLike[]
  comments    Comment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  sender     User     @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("MsgReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([receiverId, read])
  @@index([senderId, receiverId, createdAt])
}

model LocalPricePost {
  id                String   @id @default(cuid())
  postType          String   @default("PRODUCT")
  productName       String
  description       String?

  country           String
  city              String?
  neighborhood      String?
  market            String?

  currency          String
  priceMin          Float
  priceMax          Float
  recommendedPrice   Float?
  touristPrice      Float?
  personalPrice     Float?

  localTip          String?

  contactPhone      String?
  contactEmail      String?
  contactWhatsApp   String?

  category          String   @default("Other")
  imageUrl          String?

  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes            LocalPriceVote[]
  reports          LocalPriceReport[]

  helpfulCount     Int      @default(0)
  notAccurateCount Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([country, city, createdAt])
  @@index([country, category, createdAt])
  @@index([category, helpfulCount])
  @@index([authorId, createdAt])
  @@index([createdAt])
}

model LocalPriceVote {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  voteType  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      LocalPricePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId, voteType])
}

model LocalPriceReport {
  id          String   @id @default(cuid())
  userId      String
  postId      String
  reportType  String
  note        String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        LocalPricePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model GuideRating {
  id          String   @id @default(cuid())
  raterId     String
  guideId     String
  rating      Int
  comment     String?
  rater       User     @relation("GuideRatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  guide       User     @relation("GuideRatingReceiver", fields: [guideId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([raterId, guideId])
  @@index([guideId])
}
