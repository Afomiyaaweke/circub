// circub — Prisma schema
// PostgreSQL-compatible (works on Vercel Postgres, Neon, Supabase, Railway).
// On local dev, falls back to SQLite via the DATABASE_URL env var so the
// existing dev workflow keeps working without changes.
//
// Scaling notes (5,000 concurrent users target):
// - Composite indexes on every hot query path (feed list, votes, by author)
// - @@unique constraints rely on DB-level uniqueness (works across serverless)
// - No JSON columns (keeps queries fast and simple)
// - No DB-side triggers — counters are updated in transaction by Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev uses SQLite (file:./db/custom.db). Production uses Postgres
  // (postgresql://...). Prisma picks the right provider based on the
  // DATABASE_URL scheme — see prisma.config logic in lib/db.ts.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String? // hashed with bcrypt; null for Google OAuth users
  // Shareable profile handle — the unique ID people use to find and share a
  // profile (circub.app/u/<username>). Nullable: accounts created before
  // usernames existed (and Google OAuth sign-ups) can add one any time from
  // Edit profile. Always stored normalized: lowercase, [a-z0-9_], 3–20 chars.
  username       String?  @unique
  avatarColor    String   @default("teal")
  bio            String?
  headline       String?
  location       String?
  postsCount     Int      @default(0)
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  likesCount     Int      @default(0)
  connectionsCount Int    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Auth + account type
  accountType    String   @default("PERSONAL") // PERSONAL | COMPANY
  isLocal        Boolean  @default(false)
  verifiedLocal  Boolean  @default(false)

  // Account verification via ID / passport upload (any user, not just guides).
  // PRIVACY: userIdDocUrl is the document image — it is ONLY ever returned to
  // its owner (GET /api/verification). No public or social endpoint may ever
  // select it; everyone else only sees the idVerified boolean (blue badge).
  idVerified      Boolean   @default(false)
  userIdDocType   String?   // 'ID' | 'PASSPORT'
  userIdDocUrl    String?   // uploaded document (data URL) — owner-only, never exposed
  verifiedAt      DateTime?

  // Account deactivation (user-initiated soft-off; reversible by support).
  // deactivatedAt set = account signed out everywhere, login blocked with a
  // clear message, and the reason was forwarded to the contact-us inbox.
  deactivatedAt      DateTime?
  deactivationReason String?

  // Company-specific fields
  companyName    String?
  companyWebsite String?
  companyLogo    String?
  companySize    String?
  companyIndustry String?

  // Local contributor profile
  rating         Float    @default(0)
  expertiseTags  String?
  helpfulVotes   Int      @default(0)
  localPostCount Int      @default(0)

  // Tour guide (Live Zone)
  isGuide        Boolean  @default(false)
  // Live Zone roles: comma-separated slugs from src/lib/roles.ts
  // ('guide','vlogger','local','volunteer'). Null = legacy guide-only member.
  guideRoles     String?
  guideLicense   String?
  guideLanguages String?
  guideSpecialties String?
  guideHourlyRate Float?
  guideCurrency  String?
  guideBio       String?
  guideAvailable Boolean  @default(true)
  // Tour videos as links (YouTube / Instagram), comma-separated, max 3.
  // Stored as the original URLs; embeds are derived client-side.
  guideVideoUrls String?
  guideIdDocType String?   // Verification document type: 'ID' | 'PASSPORT'
  guideIdDocUrl  String?   // Uploaded ID/passport photo (data URL) — verification only, never shown publicly
  profilePicture String?

  // Contact information (same channels as local price posts: phone / email / WhatsApp)
  phone          String?
  whatsapp       String?

  products       Product[]
  posts          Post[]
  postLikes      PostLike[]
  postReposts    PostRepost[]
  comments       Comment[]
  productLikes   Like[]
  localPricePosts LocalPricePost[]
  localPriceVotes LocalPriceVote[]
  localPriceReports LocalPriceReport[]
  priceLinksCreated PricePostLink[] @relation("PricePostLinkCreator")
  guideRatingsReceived GuideRating[] @relation("GuideRatingReceiver")
  guideRatingsGiven GuideRating[] @relation("GuideRatingRater")
  bookingsAsTourist GuideBooking[] @relation("BookingTourist")
  bookingsAsGuide GuideBooking[] @relation("BookingGuide")

  // Connections (LinkedIn mutual)
  connRequested  Connection[] @relation("ConnRequester")
  connReceived  Connection[] @relation("ConnReceiver")

  // Follows (one-way network link) + blocks
  followsMade    Follow[] @relation("FollowFollower")
  followsReceived Follow[] @relation("FollowFollowing")
  blocksMade     Block[]  @relation("BlockBlocker")
  blocksReceived Block[]  @relation("BlockBlocked")

  // Direct messages
  msgsSent       Message[]    @relation("MsgSender")
  msgsReceived   Message[]    @relation("MsgReceiver")
  stories        Story[]

  @@index([accountType])
  @@index([isLocal, verifiedLocal])
  @@index([isGuide, guideAvailable])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  quantity    String
  country     String
  currency    String
  price       Float
  unit        String?
  gender      String?
  description String?
  imageUrl    String?
  category    String   @default("Other")
  // v122: the price post this product was auto-created from (one post =
  // one product). Null for standalone products added the old way. The link
  // keeps the pair in sync on edit and deletes the twin on either side.
  localPricePostId String? @unique
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       Like[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([category])
  @@index([country])
}

model Like {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// LinkedIn-style mutual connections
model Connection {
  id           String   @id @default(cuid())
  requesterId  String
  receiverId   String
  status       String   @default("PENDING") // PENDING | ACCEPTED | IGNORED
  note         String?
  requester    User     @relation("ConnRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver     User     @relation("ConnReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status]) // incoming invitations lookup
  @@index([requesterId, status])
}

// One-way follow (the network LINK): I follow you without needing your
// approval - the lightweight link alongside the mutual Connection. Counts
// live on User (followersCount / followingCount) so profiles can show them.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])  // who I follow
  @@index([followingId]) // who follows me
}

// Block: the hard cut. Blocking removes any Connection row between the two
// users and every Follow in BOTH directions, and hides each side from the
// other's suggestions. Reversible with unblock.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])  // my block list
  @@index([blockedId])  // who blocked me (suggestion exclusion)
}

// LinkedIn-style social posts (text + image + optional video link)
model Post {
  id          String     @id @default(cuid())
  content     String
  imageUrl    String?
  // Attached video via link (YouTube / Instagram). Stores the ORIGINAL url;
  // the embed player URL is derived client-side (src/lib/video.ts).
  videoUrl    String?
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       PostLike[]
  reposts     PostRepost[]
  comments    Comment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

// Repost (share to network) on a social post, one per user per post
model PostRepost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// Direct messages between two users
model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  sender     User     @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("MsgReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([receiverId, read]) // unread inbox lookup
  @@index([senderId, receiverId, createdAt]) // conversation thread
}

model Story {
  id        String   @id @default(cuid())
  // Photo stories carry the uploaded image; price stories (auto-shared when
  // a price post is published) may have no photo - the client renders a
  // price banner for those instead of an image.
  imageUrl  String?
  caption   String?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // The price post this story was shared from (created automatically when a
  // new price goes out through the composer). Cascade: deleting the post
  // removes its story with it.
  pricePostId String?  @unique
  pricePost   LocalPricePost? @relation(fields: [pricePostId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime // createdAt + 24h — stories disappear like Instagram

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

// Symmetric links between price posts ("same item posted elsewhere"): one
// row per pair with the ids stored normalized (postAId < postBId), so the
// @@unique makes a duplicate link impossible from either direction. Managed
// from the price detail modal: link another post, remove a link, count shown
// on the card.
model PricePostLink {
  id        String   @id @default(cuid())
  postAId   String
  postBId   String
  createdBy String
  creator   User     @relation("PricePostLinkCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  postA     LocalPricePost @relation("PricePostLinkA", fields: [postAId], references: [id], onDelete: Cascade)
  postB     LocalPricePost @relation("PricePostLinkB", fields: [postBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postAId, postBId])
  @@index([postAId])
  @@index([postBId])
}

// =====================================================
// LOCAL PRICE POSTS — community price intelligence
// =====================================================

model LocalPricePost {
  id                String   @id @default(cuid())
  postType          String   @default("PRODUCT") // PRODUCT | SERVICE
  productName       String
  description       String?

  // Location (multi-level)
  country           String
  city              String?
  neighborhood      String?
  market            String?

  // GPS pin (optional, tourists get one-tap directions to the exact spot)
  latitude          Float?
  longitude         Float?

  // Price information
  currency          String
  priceMin          Float
  priceMax          Float
  recommendedPrice   Float?
  touristPrice      Float?
  personalPrice     Float?

  // Local knowledge
  localTip          String?

  // v122: marketplace details carried by the unified composer - the unit the
  // price refers to ("50 / kg") and the pack size, rendered on the card and
  // synced to the auto-created Product twin.
  unit              String?
  quantity          String?

  // Contact info (for travelers to reach the local)
  contactPhone      String?
  contactEmail      String?
  contactWhatsApp   String?

  // Poster declares they own the shop/business this price belongs to
  // (shop owner posts are badged differently and are first-party prices)
  ownsShop          Boolean  @default(false)

  // Categorization
  category          String   @default("Other")
  imageUrl          String?

  // Author
  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Votes & reports
  votes            LocalPriceVote[]
  reports          LocalPriceReport[]

  // Stories shared from this post (auto-created on publish, live 24h) and
  // symmetric links to other price posts for the same item elsewhere.
  stories          Story[]
  linksA           PricePostLink[] @relation("PricePostLinkA")
  linksB           PricePostLink[] @relation("PricePostLinkB")

  helpfulCount     Int      @default(0)
  notAccurateCount Int      @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Hot query paths: feed list filtered by country/city/category, sorted by recent/popular
  @@index([country, city, createdAt])
  @@index([country, category, createdAt])
  @@index([category, helpfulCount])
  @@index([authorId, createdAt])
  @@index([createdAt])
}

model LocalPriceVote {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  voteType  String   // HELPFUL | NOT_ACCURATE
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      LocalPricePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId, voteType])
}

model LocalPriceReport {
  id          String   @id @default(cuid())
  userId      String
  postId      String
  reportType  String
  note        String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        LocalPricePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

// Guide ratings: travelers rate tour guides (1-5 stars + optional comment)
model GuideRating {
  id          String   @id @default(cuid())
  raterId     String
  guideId     String
  rating      Int      // 1-5 stars
  comment     String?
  rater       User     @relation("GuideRatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  guide       User     @relation("GuideRatingReceiver", fields: [guideId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([raterId, guideId])
  @@index([guideId])
}

// Guide bookings: tourists request a tour with a registered guide.
// status: PENDING -> ACCEPTED / DECLINED (guide), CANCELLED (tourist), COMPLETED (after tour)
model GuideBooking {
  id        String   @id @default(cuid())
  touristId String
  guideId   String
  status    String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | COMPLETED | CANCELLED
  date      DateTime? // proposed tour date
  days      Int?     // duration in days
  people    Int?     // group size
  message   String?  // tourist's request note
  reply     String?  // guide's reply note
  tourist   User     @relation("BookingTourist", fields: [touristId], references: [id], onDelete: Cascade)
  guide     User     @relation("BookingGuide", fields: [guideId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guideId, status]) // guide inbox lookup
  @@index([touristId, status]) // tourist "my requests" lookup
}

// Contact form submissions from the /contact page ("Send Us a Message").
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}
